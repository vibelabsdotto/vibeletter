# Copy to .env.production in the repository root. Never commit the copy.
# This file contains examples, not operational credentials.
NODE_ENV=production
DEV_LOGIN_ENABLED=false
APP_URL=https://letter.example.com
BETTER_AUTH_URL=https://letter.example.com
ADMIN_EMAIL=operator@example.com
# Generate each separately with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Keep stable after the first send. Rotation invalidates old recipient links.
SESSION_SECRET=

# Compose overrides both paths to the same shared local named volume.
DATABASE_PATH=/app/data/vibeletter.db
QUEUE_DATABASE_PATH=/app/data/queue.db

# Leave false until DNS, SNS feedback and simulator handling are verified.
SENDING_ENABLED=false
SEND_RATE_PER_SECOND=10
SES_REGION=us-east-1
# Empty explicit keys use the AWS SDK credential chain. Container credentials
# must be provided deliberately; the host's ~/.aws is not automatically mounted.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SESSION_TOKEN=
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
ALERT_FROM=

UPLOAD_STORAGE=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keep empty for a private bucket served through /api/files on APP_URL.
# If supplied, this HTTPS base URL must actually serve the stored images.
R2_PUBLIC_URL=

# Optional archive-only origins, without scheme or path.
# ARCHIVE_HOSTS=news.example.com=weekly,news.example.org=monthly
ARCHIVE_HOSTS=

# Client IP for rate limits. cloudflare = CF-Connecting-IP, true = trusted proxy
# X-Forwarded-For. Empty = one shared bucket for all clients.
TRUST_PROXY=
