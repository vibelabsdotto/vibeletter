{
  "name": "@vibelabsdotto/vibeletter-cli",
  "version": "0.1.0",
  "description": "Context-aware operator CLI for VibeLetter",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "vibeletter": "dist/index.js" },
  "files": ["dist", "README.md", "llms.txt", "llms-full.txt"],
  "scripts": {
    "cli": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node --check scripts/docs.mjs",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "prepack": "npm run build"
  },
  "dependencies": { "commander": "^15.0.0" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
