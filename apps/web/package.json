{
  "name": "@vibelabsdotto/vibeletter-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3035",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3035",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "queue:migrate": "tsx src/queue/migrate.ts",
    "operator:provision": "tsx --conditions=react-server src/scripts/provision-operator.ts",
    "worker": "tsx --conditions=react-server src/worker.ts",
    "test": "node --import tsx --test \"src/tests/*.test.mjs\""
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-file-handler": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "liteque": "^0.10.0",
    "zod": "^4.5.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/better-sqlite3": "^7",
    "@types/sanitize-html": "^2",
    "@types/papaparse": "^5",
    "typescript": "^7.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4"
  }
}
