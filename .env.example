# Copy to apps/web/.env.local, or load explicitly for web and worker.
# Local development only. Production must use HTTPS and DEV_LOGIN_ENABLED=false.
APP_URL=http://localhost:3035
BETTER_AUTH_URL=http://localhost:3035
ADMIN_EMAIL=dev@localhost.test
# Generate two DIFFERENT secrets: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Recipient-link signing key. Keep stable once emails have been sent.
SESSION_SECRET=
DEV_LOGIN_ENABLED=true

# Absolute paths recommended. Both processes must use the same app and queue files.
DATABASE_PATH=
QUEUE_DATABASE_PATH=

# Never enable sending until SES identities and feedback are configured.
SENDING_ENABLED=false
SEND_RATE_PER_SECOND=10
SES_REGION=us-east-1
# Empty credentials use the standard AWS credential chain.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SESSION_TOKEN=
# Both are mandatory for live sending. Topic must match the effective SES region.
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
ALERT_FROM=

# Production file storage: Cloudflare R2, scoped object read/write token.
UPLOAD_STORAGE=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public asset domain. Empty means controlled app image serving.
R2_PUBLIC_URL=
# Only development may explicitly select UPLOAD_STORAGE=local.
UPLOAD_LOCAL_DIR=

# Optional archive-only hosts, comma-separated host=newsletter-slug.
ARCHIVE_HOSTS=
