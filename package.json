{
  "name": "vibeletter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["apps/*"],
  "overrides": {
    "esbuild": "0.28.2",
    "@esbuild-kit/core-utils": { "esbuild": "0.28.2" }
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/cli --workspace apps/web",
    "lint": "npm run lint --workspace apps/cli --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/cli --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "db:generate": "npm run db:generate --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/web",
    "queue:migrate": "npm run queue:migrate --workspace apps/web",
    "operator:provision": "npm run operator:provision --workspace apps/web --",
    "worker": "npm run worker --workspace apps/web",
    "cli": "node apps/cli/dist/index.js"
  }
}
